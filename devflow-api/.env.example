# DevFlow API Environment Variables Template
# Copy this file to .env and configure your values:
# cp .env.example .env

# Server Configuration
PORT=3001
NODE_ENV=development

# JWT Authentication
JWT_SECRET=your_super_secret_jwt_key_minimum_32_characters_here
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d

# Databases & Infrastructure Services
# 1. MongoDB (Primary document store for Tasks & Users)
MONGODB_URI=mongodb://localhost:27017/devflow
# Or cloud Atlas: mongodb+srv://<username>:<password>@cluster.mongodb.net/devflow?appName=DevFlow

# 2. PostgreSQL / Supabase (Relational data & Job telemetry)
SUPABASE_URL=postgresql://postgres:postgres@localhost:5432/devflow
# Or cloud Supabase: postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# 3. Redis (High-speed cache, API rate limiting & session storage)
REDIS_URL=redis://localhost:6379
# Or cloud Redis: redis://default:<password>@<host>:<port>
